# ---- Backend (backend/config.py) ----
# Helyi fejlesztéshez SQLite; Renderen a szolgáltatói PostgreSQL belső címe (a karbantartó frissíti)
DATABASE_URL=sqlite:///./library.db
ADMIN_TOKEN=valami-hosszu-veletlen-token
MAINTENANCE_MODE=false
SEED_ON_STARTUP=true
LOG_LEVEL=INFO
LOAN_PERIOD_DAYS=14
MAX_ACTIVE_LOANS=3
DAILY_LATE_FEE=50
MAX_LATE_FEE=2000

# ---- Frontend (frontend/app.py) ----
BACKEND_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT=15

# ---- Karbantartó (maintenance/config.py, MAINT_ előtag) ----
MAINT_RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxxxxxx
MAINT_RENDER_OWNER_ID=tea-xxxxxxxxxxxxxxxxxxxx
MAINT_RENDER_SERVICE_ID=srv-xxxxxxxxxxxxxxxxxxxx
MAINT_RENDER_POSTGRES_ID=dpg-xxxxxxxxxxxxxxxxxxxx
MAINT_RENDER_REGION=frankfurt
MAINT_RENDER_PLAN=free
MAINT_RENDER_PG_VERSION=16
MAINT_BACKEND_URL=https://<sajat-backend>.onrender.com
MAINT_ADMIN_TOKEN=valami-hosszu-veletlen-token
# Elkülönített próba-adatbázis a végső mentés helyi visszaállításához (pl. docker run postgres)
MAINT_VERIFY_DATABASE_URL=postgresql+psycopg://library:library@localhost:5433/library_verify
# Opcionális: a forrás külső címe; üresen a Render API-ból kérdezi le
MAINT_SOURCE_DATABASE_URL=
MAINT_CHECK_INTERVAL_MINUTES=60
MAINT_EXPIRY_THRESHOLD_DAYS=3
# Tervezett karbantartási időpont (ISO 8601, időzónával); üresen csak a lejárat számít
MAINT_MAINTENANCE_AT=2026-11-20T18:00:00+00:00
MAINT_RULE_REFERENCE_DATE=2026-09-11
MAINT_BACKUP_DIR=backups
MAINT_STATE_DIR=state
# Engedélyek az ütemezett cseréhez (a 'rotate' parancsnál CLI-argumentumként is megadhatók)
MAINT_APPROVED_SOURCE_ID=
MAINT_ALLOW_DELETE_SOURCE_ID=
